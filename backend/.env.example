DATABASE_URL=postgresql://user:password@localhost:5432/apartment_management
PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Optional. OpenMap.vn API key, used to resolve a picked address into ward and
# city (https://docs.openmap.vn). Leave unset to run without address lookup —
# the rest of the API is unaffected.
OPENMAP_API_KEY=

# Optional as a GROUP: set all three to take payment online, or none of them.
# A partial configuration is refused at startup — a client id without a checksum
# key would create payment links whose confirmations cannot be verified, which
# looks like it is working right up until a tenant pays.
# Get them from https://my.payos.vn after creating a payment channel.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Optional, read only by `npm run seed:owner` (one-off owner bootstrap).
# CLI args take precedence: npm run seed:owner -- --phone ... --password ... --name ...
# SEED_OWNER_PHONE=
# SEED_OWNER_PASSWORD=
# SEED_OWNER_NAME=

# Browser origins allowed to call this API, comma-separated. Both surfaces need
# naming — the owner's application and the tenant portal are deployed
# separately. EMPTY MEANS ANY ORIGIN, which is what local development uses.
#   WEB_ORIGINS=https://quanly.example.com,https://cong.example.com
WEB_ORIGINS=

# Set to true when the application and this API are on DIFFERENT SITES — a
# frontend on Vercel and this on Render, say. A browser will not attach a
# SameSite=Strict cookie across sites, so the session could not be renewed.
#
# Requires NODE_ENV=production: the cookie is only marked Secure there, and
# browsers silently discard a SameSite=None cookie that is not Secure. The
# server refuses to start on that combination rather than let it fail quietly.
CROSS_SITE_COOKIES=false
