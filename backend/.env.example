DATABASE_URL=postgresql://user:password@localhost:5432/apartment_management
PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Optional, read only by `npm run seed:owner` (one-off owner bootstrap).
# CLI args take precedence: npm run seed:owner -- --phone ... --password ... --name ...
# SEED_OWNER_PHONE=
# SEED_OWNER_PASSWORD=
# SEED_OWNER_NAME=
