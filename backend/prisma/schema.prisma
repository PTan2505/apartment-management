// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  customer
}

model User {
  id           Int      @id @default(autoincrement())
  // Optional: occupants such as children need a stable identity but may have no
  // phone. Postgres allows many NULLs under a unique index, so it stays unique
  // where present. Owners always have a phone (login identifier).
  phone        String?  @unique
  passwordHash String?
  role         Role
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens  RefreshToken[]
  leaseOccupants LeaseOccupant[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Building {
  id                 Int      @id @default(autoincrement())
  displayName        String
  address            String
  electricityRate    Decimal  @db.Decimal(12, 4)
  waterRatePerPerson Decimal  @db.Decimal(12, 4)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rooms Room[]
}

model Room {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id])
  roomCode   String
  baseRent   Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leases Lease[]

  // Uniqueness of (buildingId, roomCode) among ACTIVE rooms is enforced by a
  // partial unique index added manually in the migration — Prisma's @@unique
  // cannot express a WHERE clause, and would wrongly block code reuse after
  // a room is retired.
  @@index([buildingId])
}

model Lease {
  id                Int       @id @default(autoincrement())
  roomId            Int
  room              Room      @relation(fields: [roomId], references: [id])
  startDate         DateTime
  durationMonths    Int
  // Manually maintained and authoritative for billing. Deliberately NOT derived
  // from LeaseOccupant rows: an owner may know five people live in a room while
  // holding details for only two. See design.md.
  occupantCount     Int
  moveOutDate       DateTime?
  // The meter reading this tenancy starts from. Defaulted from the previous
  // lease's endMeterReading but overridable, so electricity used while the room
  // stood empty is not charged to the incoming tenant, and a meter replaced
  // between tenancies is just a lower number rather than a special case.
  startMeterReading Int
  // Captured at move-out: closes this tenancy's electricity and becomes the
  // default starting point for the room's next lease.
  endMeterReading   Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  occupants LeaseOccupant[]
  invoices  Invoice[]

  // One ACTIVE lease per room (moveOutDate IS NULL) is enforced by a partial
  // unique index added manually in the migration.
  @@index([roomId])
}

model LeaseOccupant {
  id        Int       @id @default(autoincrement())
  leaseId   Int
  lease     Lease     @relation(fields: [leaseId], references: [id])
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  // Marks the lease signatory. Tenant-ness is a property of this relationship,
  // not of the person — the same user may be primary on one lease and an
  // ordinary occupant on another.
  isPrimary Boolean   @default(false)
  joinedAt  DateTime
  leftAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Two partial unique indexes are added manually in the migration:
  //   one active primary per lease, and no duplicate active occupant.
  @@index([leaseId])
  @@index([userId])
}

enum PaymentStatus {
  pending
  paid
}

enum PaymentMethod {
  cash
  bank_transfer
}

model Invoice {
  id      Int   @id @default(autoincrement())
  leaseId Int
  lease   Lease @relation(fields: [leaseId], references: [id])

  // The calendar month billed, and the days within it this tenancy occupied.
  year        Int
  month       Int
  periodStart DateTime
  periodEnd   DateTime

  // Metered electricity. Never prorated — the readings already measure exactly
  // what was consumed.
  previousElectricityUse Int
  currentElectricityUse  Int

  // Inputs copied at issue time. The building and room specs require that
  // changing a rate leaves issued invoices untouched.
  electricityRate    Decimal @db.Decimal(12, 4)
  waterRatePerPerson Decimal @db.Decimal(12, 4)
  baseRent           Decimal @db.Decimal(12, 2)
  occupantCount      Int

  // Each charge is rounded to whole units; totalAmount is their sum, so the
  // line items on a bill visibly add up.
  rentAmount        Decimal @db.Decimal(14, 0)
  electricityAmount Decimal @db.Decimal(14, 0)
  waterAmount       Decimal @db.Decimal(14, 0)
  totalAmount       Decimal @db.Decimal(14, 0)

  paymentStatus PaymentStatus  @default(pending)
  paymentMethod PaymentMethod?
  // Distinct from year/month: a March bill paid in May is March's billing and
  // May's cash. Revenue reporting needs both.
  paidAt        DateTime?
  // Voided invoices are retained as an audit trail, excluded from totals, and
  // excluded from the uniqueness predicate so a replacement can be issued.
  voidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One non-voided invoice per lease per month is enforced by a partial unique
  // index added manually in the migration.
  @@index([leaseId])
}
