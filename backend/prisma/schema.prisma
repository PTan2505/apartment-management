// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  customer
}

model User {
  id           Int      @id @default(autoincrement())
  // Optional: occupants such as children need a stable identity but may have no
  // phone. Postgres allows many NULLs under a unique index, so it stays unique
  // where present. Owners always have a phone (login identifier).
  phone        String?  @unique
  passwordHash String?
  role         Role
  fullName     String
  // A matching key derived from fullName, never entered by anyone and never
  // returned: lowercased with diacritics folded away, so 'Nguyễn Văn A' is
  // stored as 'nguyen van a' and a search typed without diacritics finds it.
  // The database uses the C collation, which folds case for ASCII only, so
  // neither case- nor accent-insensitive matching works on the name directly.
  // Must be rewritten by every path that writes fullName, or it goes stale and
  // the customer quietly stops being findable.
  fullNameSearch String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens  RefreshToken[]
  leaseOccupants LeaseOccupant[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Building {
  id                 Int      @id @default(autoincrement())
  displayName        String
  // The street line only — house number and street. The administrative levels
  // below are held separately so buildings can be filtered by location.
  address            String
  ward               String
  city               String
  country            String   @default("Vietnam")
  // The address provider's identifier for the place this address was resolved
  // from. Null means the address was typed by hand — which is also the right
  // state after someone corrects one, since a stale identifier would claim the
  // address came from a place it no longer matches. Deliberately not a foreign
  // key and not validated: a note about provenance, not a reference.
  placeId            String?
  electricityRate    Decimal  @db.Decimal(12, 4)
  waterRatePerPerson Decimal  @db.Decimal(12, 4)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rooms       Room[]
  expenses    Expense[]
  serviceFees BuildingServiceFee[]
}

model Room {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id])
  roomCode   String
  baseRent   Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leases   Lease[]
  expenses Expense[]

  // Uniqueness of (buildingId, roomCode) among ACTIVE rooms is enforced by a
  // partial unique index added manually in the migration — Prisma's @@unique
  // cannot express a WHERE clause, and would wrongly block code reuse after
  // a room is retired.
  @@index([buildingId])
}

model Lease {
  id                Int       @id @default(autoincrement())
  roomId            Int
  room              Room      @relation(fields: [roomId], references: [id])
  startDate         DateTime
  durationMonths    Int
  // The rent this agreement fixed, defaulted from the room at creation and
  // overridable. Deliberately a copy: the room's rent is what it asks of the
  // next tenant, and changing it must not re-price a tenancy already agreed.
  // Same precision as Room.baseRent so the copy cannot lose or gain digits.
  baseRent          Decimal   @db.Decimal(12, 2)
  // The deposit in MONTHS of rent, not currency — that is how it is agreed, and
  // the amount is derived (depositMonths × baseRent) rather than stored, so the
  // two can never disagree. Zero is a real value: a lease taken without a
  // deposit, as distinct from one whose deposit was never recorded.
  depositMonths     Int
  // Manually maintained and authoritative for billing. Deliberately NOT derived
  // from LeaseOccupant rows: an owner may know five people live in a room while
  // holding details for only two. See design.md.
  occupantCount     Int
  moveOutDate       DateTime?
  // The meter reading this tenancy starts from. Defaulted from the previous
  // lease's endMeterReading but overridable, so electricity used while the room
  // stood empty is not charged to the incoming tenant, and a meter replaced
  // between tenancies is just a lower number rather than a special case.
  startMeterReading Int
  // Captured at move-out: closes this tenancy's electricity and becomes the
  // default starting point for the room's next lease.
  endMeterReading   Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  occupants   LeaseOccupant[]
  invoices    Invoice[]
  serviceFees LeaseServiceFee[]

  // One ACTIVE lease per room (moveOutDate IS NULL) is enforced by a partial
  // unique index added manually in the migration.
  @@index([roomId])
}

model LeaseOccupant {
  id        Int       @id @default(autoincrement())
  leaseId   Int
  lease     Lease     @relation(fields: [leaseId], references: [id])
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  // Marks the lease signatory. Tenant-ness is a property of this relationship,
  // not of the person — the same user may be primary on one lease and an
  // ordinary occupant on another.
  isPrimary Boolean   @default(false)
  joinedAt  DateTime
  leftAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Two partial unique indexes are added manually in the migration:
  //   one active primary per lease, and no duplicate active occupant.
  @@index([leaseId])
  @@index([userId])
}

enum PaymentStatus {
  pending
  paid
}

enum PaymentMethod {
  cash
  bank_transfer
}

model Invoice {
  id      Int   @id @default(autoincrement())
  leaseId Int
  lease   Lease @relation(fields: [leaseId], references: [id])

  // The calendar month billed, and the days within it this tenancy occupied.
  year        Int
  month       Int
  periodStart DateTime
  periodEnd   DateTime

  // Metered electricity. Never prorated — the readings already measure exactly
  // what was consumed.
  previousElectricityUse Int
  currentElectricityUse  Int

  // Each charge is a line item, so an invoice can carry however many it has.
  // The rates and counts a charge was computed from live on the line they
  // produced, not here — one fact, one place.
  //
  // totalAmount stays stored, deliberately against this project's habit of
  // deriving such values. The revenue report sums it across many invoices, and
  // it is frozen the moment the invoice is issued. Disagreement is prevented
  // structurally instead: it is written in the same transaction as the lines
  // and nothing updates it afterwards.
  totalAmount Decimal @db.Decimal(14, 0)

  paymentStatus PaymentStatus  @default(pending)
  paymentMethod PaymentMethod?
  // Distinct from year/month: a March bill paid in May is March's billing and
  // May's cash. Revenue reporting needs both.
  paidAt        DateTime?
  // Voided invoices are retained as an audit trail, excluded from totals, and
  // excluded from the uniqueness predicate so a replacement can be issued.
  voidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems InvoiceLineItem[]

  // One non-voided invoice per lease per month is enforced by a partial unique
  // index added manually in the migration.
  @@index([leaseId])
}

enum InvoiceLineKind {
  rent
  electricity
  water
}

model InvoiceLineItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  kind InvoiceLineKind
  // Written for a reader of the bill, not for the system.
  description String

  // The basis the charge was computed from, where there was one. Rent has
  // neither: a quantity of 1 would read as information and is not.
  //
  // For a PARTIAL month these stay the full-month basis and `amount` is that
  // basis reduced by the days occupied — so amount != quantity * unitAmount,
  // and the invoice's own period is what accounts for the difference. Putting
  // the fraction into quantity would lose the rate: 0.548387 tells nobody the
  // rent is 3,000,000.
  quantity   Decimal? @db.Decimal(14, 2)
  unitAmount Decimal? @db.Decimal(12, 4)

  // Authoritative, and already rounded to whole units so a bill adds up.
  amount Decimal @db.Decimal(14, 0)

  // Fixed display order, so the same invoice reads the same way twice.
  position Int

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

enum ExpenseCategory {
  vacancy_electricity
  cleaning
  repair
  other
}

enum ExpenseOrigin {
  system
  manual
}

/// Which trigger produced a vacancy electricity record. Explicit rather than
/// inferred from a null column, because the uniqueness index keys on it.
enum VacancyReconciliation {
  month_end
  lease_start
}

// What a building charges for beyond rent and metered utilities: parking,
// internet, rubbish, shared cleaning. This is the catalogue the owner offers;
// what a particular tenancy agreed to is LeaseServiceFee.
model BuildingServiceFee {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id])

  name String
  // Charged per unit of the thing: one motorbike, one internet connection. A
  // flat fee is simply one whose quantity is always 1.
  unitAmount Decimal @db.Decimal(12, 2)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaseSelections LeaseServiceFee[]

  // Name is unique among a building's OFFERED fees — a partial unique index
  // added manually in the migration, same shape as Room.roomCode. Two entries
  // called "Parking" in one building cannot be told apart when selecting one.
  @@index([buildingId])
}

// A fee this tenancy agreed to, at the price it agreed.
model LeaseServiceFee {
  id      Int   @id @default(autoincrement())
  leaseId Int
  lease   Lease @relation(fields: [leaseId], references: [id])

  buildingServiceFeeId Int
  buildingServiceFee   BuildingServiceFee @relation(fields: [buildingServiceFeeId], references: [id])

  // COPIED at selection, never looked up again. The lease keeps the terms it
  // agreed, exactly as it does for baseRent: repricing the building's fee must
  // not reach back into an agreement already made. It is also what makes
  // retiring a fee harmless — there is nothing left to resolve at billing time.
  unitAmount Decimal @db.Decimal(12, 2)
  // How many of the thing. Changing this must NOT re-copy unitAmount: a tenant
  // buying a second motorbike has not renegotiated the price of the first.
  quantity   Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A lease selects a given fee at most once — more of a service is a quantity,
  // not a second selection. Unique index added manually in the migration.
  @@index([leaseId])
  @@index([buildingServiceFeeId])
}

model Expense {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id])
  // Cleaning and vacancy electricity are room-level; lobby repairs are not.
  roomId     Int?
  room       Room?    @relation(fields: [roomId], references: [id])

  category    ExpenseCategory
  description String
  incurredAt  DateTime
  origin      ExpenseOrigin   @default(manual)

  // Present for measured costs. When both are set the amount is computed from
  // them, so the recorded figure can never disagree with what it came from.
  quantity Decimal? @db.Decimal(14, 2)
  unitRate Decimal? @db.Decimal(12, 4)
  amount   Decimal  @db.Decimal(14, 0)

  // Vacancy electricity only. The readings keep the room's meter chain
  // unbroken between tenancies; quantity always equals their difference.
  reconciliation  VacancyReconciliation?
  year            Int?
  month           Int?
  previousReading Int?
  currentReading  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A month end can be recorded only once per room, enforced by a partial
  // unique index added manually in the migration. Turnover records are
  // deliberately excluded: a room may be re-let more than once in a month.
  @@index([buildingId])
  @@index([roomId])
}
