// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  customer
}

model User {
  id           String    @id @default(uuid())
  phone        String    @unique
  passwordHash String?
  role         Role
  fullName     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Building {
  id                 String   @id @default(uuid())
  displayName        String
  address            String
  electricityRate    Decimal  @db.Decimal(12, 4)
  waterRatePerPerson Decimal  @db.Decimal(12, 4)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rooms Room[]
}

model Room {
  id         String   @id @default(uuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  roomCode   String
  baseRent   Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Uniqueness of (buildingId, roomCode) among ACTIVE rooms is enforced by a
  // partial unique index added manually in the migration — Prisma's @@unique
  // cannot express a WHERE clause, and would wrongly block code reuse after
  // a room is retired.
  @@index([buildingId])
}
