// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  customer
}

model User {
  id String @id @default(uuid())
  // Optional: occupants such as children need a stable identity but may have no
  // phone. Postgres allows many NULLs under a unique index, so it stays unique
  // where present. Owners always have a phone (login identifier).
  phone        String?  @unique
  passwordHash String?
  role         Role
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens  RefreshToken[]
  leaseOccupants LeaseOccupant[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Building {
  id                 String   @id @default(uuid())
  displayName        String
  address            String
  electricityRate    Decimal  @db.Decimal(12, 4)
  waterRatePerPerson Decimal  @db.Decimal(12, 4)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rooms Room[]
}

model Room {
  id         String   @id @default(uuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  roomCode   String
  baseRent   Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leases Lease[]

  // Uniqueness of (buildingId, roomCode) among ACTIVE rooms is enforced by a
  // partial unique index added manually in the migration — Prisma's @@unique
  // cannot express a WHERE clause, and would wrongly block code reuse after
  // a room is retired.
  @@index([buildingId])
}

model Lease {
  id             String    @id @default(uuid())
  roomId         String
  room           Room      @relation(fields: [roomId], references: [id])
  startDate      DateTime
  durationMonths Int
  // Manually maintained and authoritative for billing. Deliberately NOT derived
  // from LeaseOccupant rows: an owner may know five people live in a room while
  // holding details for only two. See design.md.
  occupantCount  Int
  moveOutDate    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  occupants LeaseOccupant[]

  // One ACTIVE lease per room (moveOutDate IS NULL) is enforced by a partial
  // unique index added manually in the migration.
  @@index([roomId])
}

model LeaseOccupant {
  id        String    @id @default(uuid())
  leaseId   String
  lease     Lease     @relation(fields: [leaseId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  // Marks the lease signatory. Tenant-ness is a property of this relationship,
  // not of the person — the same user may be primary on one lease and an
  // ordinary occupant on another.
  isPrimary Boolean   @default(false)
  joinedAt  DateTime
  leftAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Two partial unique indexes are added manually in the migration:
  //   one active primary per lease, and no duplicate active occupant.
  @@index([leaseId])
  @@index([userId])
}
