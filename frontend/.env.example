# Where the dev server proxies /api/* requests.
# Must match the backend's PORT. Note that port 5000 collides with macOS
# AirPlay Receiver, so the backend is often run on another port locally.
VITE_API_TARGET=http://localhost:5000

# The address the BROWSER calls for the API. Different from VITE_API_TARGET
# above: that one tells the DEV SERVER where to forward /api/*, and has no
# effect on a built bundle.
#
# Leave BLANK for local development — the relative /api path is proxied.
#
# REQUIRED for a production build, which has no proxy behind it. The build
# refuses without it rather than shipping an application that asks its own
# origin for the API and only fails at the first sign-in:
#   VITE_API_URL=https://apartment-management-api.onrender.com
VITE_API_URL=

# Where the TENANT PORTAL is served from, used to build the payment link the
# owner copies from a tenancy.
#
# Leave BLANK unless the portal is deployed separately: /portal is a route in
# this same application, so the link is built from the address the owner is
# already on. Set it only when the portal has its own host, or every link an
# owner sends would point somewhere that does not serve it:
#   VITE_PORTAL_URL=https://cong.example.com/portal
VITE_PORTAL_URL=
